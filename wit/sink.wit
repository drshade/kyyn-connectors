package kyyn:sink@1.0.0;

/// The first write-distinct host capability. The target path is deliberately
/// absent: the host binds one accepted sink instance to one consented file.
interface file-replace {
    record applied {
        previous-sha256: string,
        resulting-sha256: string,
        bytes: u64,
    }

    record created {
        resulting-sha256: string,
        bytes: u64,
    }

    record already-converged {
        resulting-sha256: string,
        bytes: u64,
    }

    record conflict {
        expected-sha256: string,
        observed-sha256: string,
    }

    record create-conflict {
        observed-sha256: string,
    }

    variant replace-outcome {
        applied(applied),
        created(created),
        already-converged(already-converged),
        conflict(conflict),
        create-conflict(create-conflict),
    }

    record host-failure {
        /// Stable bounded machine-readable code.
        code: string,
        /// Bounded human diagnostic; never target bytes or credentials.
        message: string,
        retryable: bool,
    }

    /// Compare the host-bound regular file with `expected-current-state` and
    /// atomically create or replace it with the exact accepted bytes. State is
    /// `absent` or a lowercase SHA-256. An invocation may call this at most once;
    /// the host enforces the claim and target authority.
    replace: func(
        expected-current-state: string,
        replacement: list<u8>,
    ) -> result<replace-outcome, host-failure>;
}

/// One host-bound compare-and-swap of one consented foreign branch. The
/// repository and reference are deliberately absent: the host binds them from
/// the accepted sink declaration and machine authority.
interface git-ref {
    record applied {
        previous-oid: string,
        resulting-oid: string,
    }

    record already-converged {
        resulting-oid: string,
    }

    record conflict {
        expected-oid: string,
        /// None means the consented branch is absent.
        observed-oid: option<string>,
    }

    variant transition-outcome {
        applied(applied),
        already-converged(already-converged),
        conflict(conflict),
    }

    record host-failure {
        /// Stable bounded machine-readable code.
        code: string,
        /// Bounded human diagnostic; never object bytes or credentials.
        message: string,
        retryable: bool,
    }

    /// Ensure exactly the accepted one-parent commit transition. An invocation
    /// may call this at most once; the host revalidates the exact bundle and
    /// enforces the claim, target authority and ref CAS.
    ensure: func(
        expected-oid: string,
        new-oid: string,
        bundle: list<u8>,
    ) -> result<transition-outcome, host-failure>;
}

/// One host-bound remote request. Provider resource identities, realms, URLs
/// and credentials are deliberately absent from the guest-selected operation.
interface request {
    enum body-source {
        none,
        /// The exact payload bytes from the accepted effect envelope. The
        /// guest selects this source but never supplies or transforms bytes.
        accepted-artifact,
    }

    record operation {
        /// Immutable request-grant name from the pinned connector manifest.
        grant: string,
        /// Only names reviewed by that grant are accepted. Credentials,
        /// authority, method, path and framing always remain host-owned.
        headers: list<tuple<string, string>>,
        body: body-source,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    enum error-kind {
        denied-request,
        timeout,
        too-large,
        transport,
        invalid,
    }

    record request-error {
        kind: error-kind,
        message: string,
    }

    /// Execute one exact host-resolved operation. Request authority is derived
    /// only from the accepted connector pin, sink config, named connection and
    /// effect artifact; no guest-selected URL or request bytes cross the ABI.
    fetch: func(operation: operation) -> result<response, request-error>;
}

/// Direction-distinct sink behaviour. These exports carry no authority by
/// themselves. Validation and rendering execute with all write handlers
/// disabled; apply receives only the imports earned by accepted consent.
interface api {
    record connector-describe {
        name: string,
    }

    /// The complete accepted input to connector validation/render/apply. The
    /// engine independently binds the config and envelope hashes; the component
    /// cannot replace them with values of its own.
    record effect {
        /// Canonical RON config text from the accepted sink declaration.
        config: string,
        /// Connector-defined canonical target identity rendered and accepted
        /// by the owner; it never grants destination authority.
        expected-target: string,
        payload-media-type: string,
        /// Exact accepted payload bytes from the intended-effect envelope.
        payload: list<u8>,
    }

    record effect-rendering {
        /// Concrete destination shown on the owner review surface.
        destination: string,
        /// Bounded connector-specific summary; the engine separately renders
        /// the authoritative payload bytes and target identity.
        summary: string,
    }

    record target-observation {
        /// Connector-defined bounded state, frozen into the intended effect.
        expected-target: string,
        destination: string,
        summary: string,
    }

    record observed-outcome {
        /// Connector-defined bounded post-operation state.
        observed-state: string,
        note: string,
    }

    record conflict-outcome {
        observed-state: string,
        message: string,
    }

    record failed-outcome {
        code: string,
        message: string,
        retryable: bool,
    }

    variant outcome {
        applied(observed-outcome),
        already-converged(observed-outcome),
        conflict(conflict-outcome),
        failed(failed-outcome),
    }

    record apply-report {
        /// Provider semantics reported by the connector. The engine records
        /// this separately from its own request/artifact attestations.
        outcome: outcome,
    }

    describe: func() -> connector-describe;
    validate-config: func(config: string) -> result<_, string>;
    /// Remote connectors observe through request grants. Specialized local
    /// primitives return an error here because their host owns observation.
    observe: func(config: string) -> result<target-observation, string>;
    validate-effect: func(effect: effect) -> result<_, string>;
    render-effect: func(effect: effect) -> result<effect-rendering, string>;
    apply: func(effect: effect) -> result<apply-report, string>;
}

/// A sink component's actual import set is its effect signature. The world has
/// no WASI imports and intentionally shares no interface with kyyn:source@1.
world sink {
    import file-replace;
    export api;
}

/// Direction- and effect-distinct world for the federation sink guest.
world git-ref-sink {
    import git-ref;
    export api;
}

/// Provider-neutral remote publication guest.
world remote-sink {
    import request;
    export api;
}

/// Host union used by the engine to instantiate effect-distinct components.
/// Each component's actual import set remains its exact effect signature.
world host-sink {
    import file-replace;
    import git-ref;
    import request;
    export api;
}
