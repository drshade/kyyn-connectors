package kyyn:source@1.0.0;

/// Ambient-authority-free utilities every connector may use.
interface control {
    /// One short progress line, forwarded live to the owner's surface.
    progress: func(message: string);

    /// Wall-clock milliseconds since the Unix epoch. Connectors are explicitly
    /// non-deterministic; this is for window math and backoff, not replay.
    now-ms: func() -> u64;

    /// Cooperative wait (retry backoff, poll intervals). The host may wake
    /// early; the call deadline keeps ticking.
    sleep-ms: func(duration-ms: u64);
}

/// Host-mediated HTTP. Every request is checked against the connector's
/// consented purpose/method/origin/path grants before any connection is made;
/// a denied request is an observable error, never a silent block.
interface http {
    enum purpose {
        observe,
        authenticate,
    }

    enum method {
        get,
        post,
    }

    record request {
        purpose: purpose,
        method: method,
        url: string,
        /// Ordered request headers. The host refuses `authorization` values
        /// it cannot attribute (see `secret-authorization`), hop-by-hop
        /// headers, and oversized header blocks.
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
        /// When set, the host reads this secret from the connector's realm and
        /// sends `Authorization: Bearer <value>` without the value ever
        /// entering guest memory. Mutually exclusive with a guest-supplied
        /// `authorization` header.
        secret-authorization: option<string>,
        /// Hard ceiling on the buffered response body.
        max-response-bytes: u64,
        /// Per-request ceiling; the verb deadline still applies overall.
        timeout-ms: u64,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    enum error-kind {
        /// Purpose, method, HTTPS origin or bounded path is outside consent.
        denied-request,
        /// Request or connect exceeded its time budget.
        timeout,
        /// Response body exceeded `max-response-bytes`.
        too-large,
        /// DNS/TLS/transport failure.
        transport,
        /// The request itself was malformed or used a refused header.
        invalid,
    }

    record http-error {
        kind: error-kind,
        message: string,
    }

    /// Buffered request/response for API traffic.
    fetch: func(request: request) -> result<response, http-error>;

    /// Bounded concurrent buffered traffic. The host refuses the complete
    /// group before dispatch when it is empty, has more than eight requests,
    /// exceeds the aggregate response allowance, or contains any request
    /// outside its consented grant. Once dispatched, results retain request
    /// order and each request reports its own transport outcome.
    fetch-many: func(requests: list<request>) -> result<list<result<response, http-error>>, http-error>;

    /// Download a response body straight into an evidence file without the
    /// bytes crossing the guest boundary. The URL-to-file lineage is
    /// host-attested. `path` is an out-dir-relative evidence path.
    record stored-file {
        sha256: string,
        bytes: u64,
    }

    fetch-to-evidence: func(request: request, path: string) -> result<tuple<u16, stored-file>, http-error>;
}

/// Realm-scoped credential blobs, replacing the mounted secrets directory.
/// The host resolves the realm exactly as before (explicit declaration →
/// config-derived → describe → connector name), holds the realm lock for the
/// duration of the call, and grants this interface only to auth-declaring
/// connectors on auth and fetch calls.
interface secrets {
    /// `name` is a single path-safe token.
    get: func(name: string) -> option<list<u8>>;
    put: func(name: string, value: list<u8>) -> result<_, string>;
    delete: func(name: string);
}

/// Pinned-repository trees, replacing subprocess git. The host performs the
/// clone/fetch with the owner's ordinary git authority; the guest sees only
/// the resolved tree. Every `url` must equal a consented config value.
interface repo {
    /// `ls-remote` equivalent: the commit OID a ref currently points at.
    resolve: func(url: string, reference: string) -> result<string, string>;

    record entry {
        path: string,
        bytes: u64,
    }

    resource tree {
        /// The resolved commit OID of this tree.
        head: func() -> string;
        /// Every regular file, sorted by path. Symlinks and submodules are
        /// never listed. `.git` never appears.
        entries: func() -> list<entry>;
        /// Read one file, refused above `max-bytes`.
        read: func(path: string, max-bytes: u64) -> result<list<u8>, string>;
        /// Copy one file into evidence without crossing the guest boundary.
        copy-to-evidence: func(path: string, dest: string, max-bytes: u64) -> result<stored-file, string>;
    }

    record stored-file {
        sha256: string,
        bytes: u64,
    }

    /// Materialize `url` at `reference` (ref name, or full 40-hex OID).
    open: func(url: string, reference: string) -> result<tree, string>;
}

/// Consented local directory roots (the `Path`-typed config fields the
/// owner accepted), replacing read-only bind mounts. Paths are host paths;
/// the host expands `~` and refuses anything that escapes a consented root.
interface local {
    record entry {
        path: string,
        bytes: u64,
        /// Milliseconds since epoch, 0 when unavailable.
        modified-ms: u64,
    }

    record stored-file {
        sha256: string,
        bytes: u64,
    }

    /// Every regular file under the root, sorted. Symlinks are neither
    /// followed nor listed.
    entries: func(root: string) -> result<list<entry>, string>;
    read: func(root: string, path: string, max-bytes: u64) -> result<list<u8>, string>;
    copy-to-evidence: func(root: string, path: string, dest: string, max-bytes: u64) -> result<stored-file, string>;
}

/// Host-owned evidence output, replacing the writable out-dir. Files exist
/// only through this interface, so digests are computed by the host as the
/// bytes arrive and containment is structural rather than re-checked.
interface evidence {
    record stored-file {
        sha256: string,
        bytes: u64,
    }

    resource file {
        write: func(chunk: list<u8>) -> result<_, string>;
        /// Flush, close and return the host-computed digest — the last call
        /// on the handle. The err carries an I/O failure (flush, hash
        /// close-out, rename). After a successful finish, `write` returns an
        /// error; dropping the handle without a successful finish discards
        /// the file, which then may not be referenced by an item.
        finish: func() -> result<stored-file, string>;
    }

    /// `path` is out-dir-relative, gated against traversal, unique per run.
    open: func(path: string) -> result<file, string>;
}

/// The connector surface. The WIT package version replaces the old
/// `Describe.protocol` field: an engine either implements the version a
/// component names or fails closed.
interface api {
    enum fetch-style {
        windowed,
        snapshot,
        sweep,
    }

    record connector-describe {
        name: string,
        link-namespace: string,
        fetch-style: fetch-style,
        auth-realm: option<string>,
    }

    record window {
        /// RFC3339 UTC, half-open [start, until).
        start: string,
        until: string,
    }

    variant run-spec {
        window(window),
        snapshot,
        sweep,
    }

    record fetch-request {
        /// Canonical RON config text, exactly as consented in sources.ron.
        config: string,
        /// Canonical non-secret config of the selected named connection.
        /// Credential material remains host-only and is never carried here.
        connection-config: option<string>,
        spec: run-spec,
        /// Engine-owned; advances only when a run manifest publishes.
        checkpoint: option<string>,
    }

    record item {
        id: string,
        kind: string,
        version: option<string>,
        content-hash: string,
        files: list<string>,
        /// Exact member of `files` that `content-hash` and an optional
        /// locator describe. Bundle ordering carries no semantic meaning.
        primary: string,
        file-hashes: list<tuple<string, string>>,
        locator: option<string>,
        meta: string,
    }

    record pending {
        /// Provider hint for an external scheduler; Kyyn never sleeps or
        /// schedules the next invocation from this value.
        retry-after-seconds: option<u32>,
    }

    variant fetch-completion {
        /// The requested run spec was fully observed, even when it yielded no
        /// items. A published complete window may advance.
        complete,
        /// A durable but inactive batch of a logical attempt. Pending results
        /// may carry complete items and require a successor checkpoint; Kyyn
        /// activates the accumulated attempt only when a later batch is
        /// complete.
        pending(pending),
    }

    record fetch-result {
        completion: fetch-completion,
        /// Connector-computed digest of the canonical observation context
        /// captured before item collection (for example, a population
        /// roster). Required by Kyyn for every resumable Pending chain and
        /// folded into the engine-owned logical-attempt identity.
        attempt-context-sha256: option<string>,
        items: list<item>,
        notes: string,
        next-checkpoint: option<string>,
    }

    record auth-challenge {
        verification-url: string,
        user-code: string,
        expires-in-secs: u64,
        /// Opaque continuation the engine round-trips to auth-poll — the
        /// sanctioned carrier of cross-call sign-in state.
        handle: string,
    }

    variant auth-poll-result {
        pending,
        done(string),
        failed(string),
    }

    variant auth-status {
        not-required,
        authenticated(string),
        not-authenticated(string),
    }

    describe: func() -> connector-describe;
    validate-config: func(config: string) -> result<_, string>;
    config-auth-realm: func(config: string) -> result<option<string>, string>;
    status: func(config: string) -> result<auth-status, string>;
    auth-begin: func(config: string) -> result<auth-challenge, string>;
    auth-poll: func(config: string, handle: string) -> result<auth-poll-result, string>;
    fetch: func(request: fetch-request) -> result<fetch-result, string>;
}

/// A repository connector component. A component's ACTUAL import set — not this
/// world's maximal one — is its capability signature: the engine grants
/// exactly the interfaces the consented manifest declares and refuses any
/// component importing beyond them.
world source {
    import control;
    import http;
    import secrets;
    import repo;
    import local;
    import evidence;

    export api;
}
