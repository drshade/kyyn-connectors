         config: [
            (name: "owner_addresses", doc: "Your own addresses (lowercased).", ty: StrList, example: Some("you@company.com")),
         ]),
        (name: "graph-org-meetings", summary: "Resumable workload Microsoft 365 meeting occurrences joined with retained transcripts and attendance for an explicit organization population.",
         world: "kyyn:source@1", namespace: "graph-org",
         connection: (provider: "microsoft", capabilities: ["directory-users-read", "meetings-read"], principal_classes: [WorkloadApplication]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users/{segment}"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users/{segment}/calendarView"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users/{segment}/onlineMeetings"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users/{segment}/onlineMeetings/{segment}/transcripts"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users/{segment}/onlineMeetings/{segment}/transcripts/{segment}/content"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users/{segment}/onlineMeetings/{segment}/attendanceReports"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/users/{segment}/onlineMeetings/{segment}/attendanceReports/{segment}/attendanceRecords"),
         ]),
         component: "components/sources/graph-org-meetings.wasm",
         component_sha256: "99fbf88d3dc2cba1b7772ae4957fc74185730f44d1ae06f496b8c1b32d4f2022",
         evidence_tools: [
            (name: "meeting-occurrences", description: "Consolidate verified observer copies by held occurrence while keeping recurring-series dates separate.",
             parameters: Struct(fields: [
                (name: "items", description: "Exact meeting item-version keys, in requested order.", type: List(item: String(max_bytes: 512), max_items: 128)),
             ]), result: Text(max_bytes: 2097152), world: "kyyn:evidence-tool@1", execution_profile: "kyyn-evidence-tool-contained-1",
             component: "components/evidence-tools/graph-meeting-occurrences.wasm", component_sha256: "ffecde923a8f10494af77e1e40f7dc4c899c243963d1d7883b90af6fe9b6b48a"),
