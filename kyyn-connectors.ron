         config: [
            (name: "owner_addresses", doc: "Your own addresses (lowercased).", ty: StrList, example: Some("you@company.com")),
         ]),
        (name: "microsoft-files", summary: "One owner-resolved SharePoint or OneDrive file, or a recursively filtered folder, as versioned evidence.",
         world: "kyyn:source@1", namespace: "microsoft-file",
         connection: (provider: "microsoft", capabilities: ["files-read"], principal_classes: [DelegatedHuman, WorkloadApplication]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/items/{segment}"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/items/{segment}/children"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/items/{segment}/content", continuation: ProviderDownload),
         ]),
         component: "components/sources/microsoft-files.wasm",
         component_sha256: "0d5c78fa6aeeb461c042e33e88bb69acca6eac1ef3f0b81baaa494de333795e0",
         config: [
            (name: "resource_link", label: Some("SharePoint or OneDrive link"), doc: "Paste a browser link to one file or folder. Kyyn resolves it once and does not store the link.", required: true, example: Some("https://tenant.sharepoint.com/sites/Team/Shared%20Documents/report.xlsx"), custody: Ephemeral, control: ResourceLink),
            (name: "drive_id", label: Some("Drive identity"), doc: "Canonical drive identity produced during link resolution.", required: true, example: Some("<resolved-drive-id>")),
            (name: "item_id", label: Some("Item identity"), doc: "Canonical file or folder identity produced during link resolution.", required: true, example: Some("<resolved-item-id>")),
            (name: "item_kind", label: Some("Item type"), doc: "Resolved target type.", required: true, example: Some("file"), control: Choice(options: ["file", "folder"])),
            (name: "display_name", label: Some("Display name"), doc: "Safe owner-facing label produced during link resolution.", required: true, example: Some("report.xlsx")),
            (name: "patterns", label: Some("Folder file patterns"), doc: "For a folder, globs relative to that folder; ** crosses levels.", ty: StrList, example: Some("**/*.xlsx"), default: Some("**/*")),
            (name: "kind", label: Some("Evidence kind"), doc: "The evidence kind each included file carries.", default: Some("file")),
            (name: "max_file_bytes", label: Some("Maximum file size"), doc: "Per-file byte cap; larger files are reported and skipped.", ty: Int, default: Some("67108864")),
         ],
         configurator: (
            world: "kyyn:configurator@1",
            component: "components/configurators/microsoft-files.wasm",
            component_sha256: "0cb0964f52fde5dfda2498569e662fa060364f91dc4adcad4d50eb6019c6e97c",
            requests: [
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/shares/{segment}/driveItem"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}:/{path}"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}/drives"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root:/{path}"),
            ],
            produces: ["drive_id", "item_id", "item_kind", "display_name"],
            max_input_bytes: 65536,
            max_output_bytes: 262144,
         )),
    ],
    sinks: [
        (name: "file-replace", summary: "Atomically create or replace one owner-consented local file when its reviewed state still matches.",
         world: "kyyn:sink@1", delivery: Convergent,
         component: "components/sinks/file-replace.wasm",
         component_sha256: "2c733e506a1e6beab5e9f8463ba03a61d89dbe9eb82b4f5b510deb36b19a9641",
         config: [
            (name: "path", doc: "Absolute normalized destination path outside the KB and Kyyn state roots.", ty: Path, required: true, example: Some("/srv/kyyn/report.bin")),
         ]),
        (name: "git-ref", summary: "Compare-and-swap one owner-consented branch to one accepted preconstructed commit.",
         world: "kyyn:sink@1", delivery: CasConvergent,
         component: "components/sinks/git-ref.wasm",
         component_sha256: "d50fd78ec95ed257906decd85875dcb7083f87a517c1912cdbd8ed9ac4851fb0",
         config: [
            (name: "repository", doc: "Absolute ssh:// or https:// URL of the foreign Git repository.", required: true, example: Some("ssh://git.example/exports/team.git")),
            (name: "reference", doc: "Canonical full branch reference bound by standing consent.", required: true, example: Some("refs/heads/main")),
         ]),
        (name: "microsoft-file-replace", summary: "Create or replace one owner-resolved SharePoint/OneDrive file when its reviewed provider state still matches.",
         world: "kyyn:sink@1", delivery: Convergent,
         connection: (provider: "microsoft", capabilities: ["files-write"], principal_classes: [DelegatedHuman, WorkloadApplication]),
         component: "components/sinks/microsoft-file-replace.wasm",
         component_sha256: "272853d4e33b904692fedc329def60f258cdbf17a7e3fbe6de828640d24b9b74",
         capabilities: (requests: [
            (name: "existing-metadata", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}",
             path_bindings: ["config:drive_id", "config:item_id"], body: None,
             max_response_bytes: 1048576, timeout_ms: 30000, max_operations: 2),
            (name: "existing-content", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}/content",
             path_bindings: ["config:drive_id", "config:item_id"], body: None,
             continuation: ProviderDownload,
             max_response_bytes: 16777216, timeout_ms: 120000, max_operations: 2),
            (name: "existing-upload", phase: Apply, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Put,
             path: "/v1.0/drives/{segment}/items/{segment}/content",
             path_bindings: ["config:drive_id", "config:item_id"], body: AcceptedArtifact,
             headers: ["content-type", "if-match"],
             max_response_bytes: 1048576, timeout_ms: 120000, max_operations: 1),
            (name: "child-metadata", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}:/{segment}",
             path_bindings: ["config:drive_id", "config:item_id", "config:filename"], body: None,
             max_response_bytes: 1048576, timeout_ms: 30000, max_operations: 2),
            (name: "child-content", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}:/{segment}:/content",
             path_bindings: ["config:drive_id", "config:item_id", "config:filename"], body: None,
             continuation: ProviderDownload,
             max_response_bytes: 16777216, timeout_ms: 120000, max_operations: 2),
            (name: "child-upload", phase: Apply, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Put,
             path: "/v1.0/drives/{segment}/items/{segment}:/{segment}:/content",
             path_bindings: ["config:drive_id", "config:item_id", "config:filename"], body: AcceptedArtifact,
             headers: ["content-type", "if-none-match"],
             max_response_bytes: 1048576, timeout_ms: 120000, max_operations: 1),
         ]),
         config: [
            (name: "resource_link", label: Some("SharePoint or OneDrive link"), doc: "Paste a browser link to one file or folder. Kyyn resolves it once and does not store the link.", required: true, example: Some("https://tenant.sharepoint.com/sites/Team/Shared%20Documents/report.xlsx"), custody: Ephemeral, control: ResourceLink),
            (name: "drive_id", label: Some("Drive identity"), doc: "Canonical drive identity produced during link resolution.", required: true, example: Some("<resolved-drive-id>")),
            (name: "item_id", label: Some("Item identity"), doc: "Canonical file or folder identity produced during link resolution.", required: true, example: Some("<resolved-item-id>")),
            (name: "item_kind", label: Some("Item type"), doc: "Resolved target type.", required: true, example: Some("file"), control: Choice(options: ["file", "folder"])),
            (name: "display_name", label: Some("Display name"), doc: "Safe owner-facing label produced during link resolution.", required: true, example: Some("report.xlsx")),
            (name: "target_mode", label: Some("Output action"), doc: "Replace the linked file, or create/replace one named child in the linked folder.", required: true, example: Some("existing-file"), control: Choice(options: ["existing-file", "folder-child"])),
            (name: "filename", label: Some("Filename in folder"), doc: "Required only for a folder output.", example: Some("dashboard.html")),
         ],
         configurator: (
            world: "kyyn:configurator@1",
            component: "components/configurators/microsoft-files.wasm",
            component_sha256: "0cb0964f52fde5dfda2498569e662fa060364f91dc4adcad4d50eb6019c6e97c",
            requests: [
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/shares/{segment}/driveItem"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}:/{path}"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}/drives"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root:/{path}"),
            ],
            produces: ["drive_id", "item_id", "item_kind", "display_name"],
            max_input_bytes: 65536,
            max_output_bytes: 262144,
         )),
