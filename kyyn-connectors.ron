                (name: "cursor", description: "Optional byte cursor in the retained transcript.", type: Optional(U64), required: false),
                (name: "max_bytes", description: "Requested transcript page bytes, bounded to 131072.", type: Optional(U64), required: false),
             ]), result: Text(max_bytes: 262144), world: "kyyn:evidence-tool@1", execution_profile: "kyyn-evidence-tool-contained-1",
             component: "components/evidence-tools/graph-meeting-transcript.wasm", component_sha256: "581653e49e13fcbb81136c6a71c379b7c99a271436ef521460106dac275db14c"),
            (name: "meeting-attendance", description: "Render deduplicated attendance for one held occurrence without merging recurring-series dates.",
             parameters: Struct(fields: [
                (name: "items", description: "Exact item-version keys for the held occurrence.", type: List(item: String(max_bytes: 512), max_items: 128)),
                (name: "occurrence_id", description: "Connector occurrence identity shared by every item.", type: String(max_bytes: 512)),
             ]), result: Text(max_bytes: 2097152), world: "kyyn:evidence-tool@1", execution_profile: "kyyn-evidence-tool-contained-1",
             component: "components/evidence-tools/graph-meeting-attendance.wasm", component_sha256: "d5d4421b4343cebbe8162cc928c190d4346067e138cce683ab09cf54450a5275"),
         ],
         config: [
            (name: "scope_mode", label: Some("Population"), doc: "Choose every enabled organization member or an explicit selected set.", required: true, example: Some("all-members"), custody: Promotable, control: Choice(options: ["all-members", "selected-members"])),
            (name: "selected_users", label: Some("Selected user principal names"), doc: "Lowercase user principal names; required only for Selected members.", ty: StrList, example: Some("member@example.org"), custody: Promotable),
            (name: "scope", label: Some("Governed population scope"), doc: "Closed AllMembers or non-empty SelectedMembers scope emitted by setup.", ty: Ron, required: true, example: Some("AllMembers")),
         ],
         configurator: (
            world: "kyyn:configurator@1",
            component: "components/configurators/graph-population.wasm",
            component_sha256: "f568c542b2722fb334308767479abb8130514d4e4b88338353b72afe691d37e1",
            requests: [],
