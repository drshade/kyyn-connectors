// First-party, digest-pinned, direction-distinct connectors. Every authority
// grant belongs to one component; repository co-location grants no union.
// Provider-selected file downloads are explicit, bounded host continuations;
// their bearer-like URLs never cross into connector memory.
(
    connector_manifest: 1,
    connections: [
        (name: "microsoft", summary: "A reusable Microsoft 365 account connection with least-privilege capability enrollment.",
         world: "kyyn:connection@1",
         component: "components/connections/microsoft-connection.wasm",
         component_sha256: "c9b3a15d1eeeb61640afb26ca5086c0ed52817017445085ee0b0d2db4b39c5c6",
         capabilities: ["calendar-read", "chats-read", "files-read", "files-write", "mail-read", "meetings-read"],
         principal_classes: [DelegatedHuman, WorkloadApplication],
         workload_recipes: [(
            name: "client-secret",
            summary: "Exchange one runner-local Entra application client secret for a short-lived Microsoft Graph application token.",
            inputs: [(
                name: "client-secret",
                label: "Client secret",
                doc: "Runner-local secret for the accepted tenant-specific Entra application; never persisted by Kyyn.",
                kind: ClientSecret,
                max_bytes: 16384,
            )],
         )],
         requests: [
            (purpose: Authenticate, authorization: None, authority: "https://login.microsoftonline.com", method: Post, path: "/{segment}/oauth2/v2.0/devicecode"),
            (purpose: Authenticate, authorization: None, authority: "https://login.microsoftonline.com", method: Post, path: "/{segment}/oauth2/v2.0/token"),
         ],
         verification_origins: [
            "https://microsoft.com",
            "https://www.microsoft.com",
            "https://login.microsoft.com",
            "https://login.microsoftonline.com",
         ],
         config: [
            (name: "tenant", doc: "Entra tenant GUID or domain. Delegated sign-in may use organizations; workload Connections require an explicit tenant.", default: Some("organizations")),
            (name: "client_id", doc: "Entra application id. Delegated sign-in defaults to Kyyn's shared public app; workload Connections require the owner's explicit application id.", default: Some("53ddb21b-849f-45a3-8168-8a0e555f386f")),
         ]),
        (name: "salesforce", summary: "A reusable Salesforce org connection using delegated device flow or a runner-bound workload application.",
         world: "kyyn:connection@1",
         component: "components/connections/salesforce-connection.wasm",
         component_sha256: "72c177e4783d87e6ae84f5fcb169ec46ea4ec4d7c102f9e2ee77dccef2d4ce99",
         capabilities: ["api"],
         principal_classes: [DelegatedHuman, WorkloadApplication],
         workload_recipes: [(
            name: "client-secret",
            summary: "Exchange one runner-local Salesforce application client secret for a short-lived integration-user token.",
            inputs: [(
                name: "client-secret",
                label: "Client secret",
                doc: "Runner-local consumer secret for the accepted Salesforce application; never persisted by Kyyn.",
                kind: ClientSecret,
                max_bytes: 16384,
            )],
         )],
         requests: [
            (purpose: Authenticate, authorization: None, authority: "config:instance_url", method: Post, path: "/services/oauth2/token"),
         ],
         verification_origins: [
            "config:instance_url",
            "https://login.salesforce.com",
            "https://test.salesforce.com",
         ],
         config: [
            (name: "instance_url", doc: "The org's exact My Domain HTTPS origin.", ty: HttpsOrigin, required: true, example: Some("https://acme.my.salesforce.com")),
            (name: "client_id", doc: "The Connected or External Client App consumer key (not a secret). Enable device flow for delegated use or client credentials with an integration Run As user for workload use.", required: true, example: Some("3MVG9…")),
         ]),
    ],
    sources: [
        (name: "sweep", summary: "Glob a local directory tree into hashed, versioned evidence.",
         world: "kyyn:source@1", namespace: "file",
         component: "components/sources/sweep.wasm",
         component_sha256: "aa1b98e727d5b595a6580402370c5435b9ee65fc528ac5181a60f02cb25e47b1",
         config: [
            (name: "root", doc: "The directory tree to sweep (~ expands).", ty: Path, required: true, example: Some("~/notes")),
            (name: "patterns", doc: "Globs relative to root; * stays within one level, ** crosses.", ty: StrList, example: Some("**/*.md"), default: Some("**/*")),
            (name: "kind", doc: "The item kind swept files carry.", default: Some("file")),
            (name: "max_file_bytes", doc: "Per-file size cap; larger files skip with a note.", ty: Int, default: Some("67108864")),
         ]),
        (name: "git-repo", summary: "Any git repository's tree (local or remote) at a ref, swept as versioned evidence.",
         world: "kyyn:source@1", namespace: "repo", capabilities: (repo: true),
         component: "components/sources/git-repo.wasm",
         component_sha256: "f2c6bbf75905908235ad7d5690d3aba04ac7caa5fc01eb81d559ba88b463906a",
         config: [
            (name: "url", doc: "Git URL or local path of the repository.", required: true, example: Some("https://github.com/org/repo")),
            (name: "git_ref", doc: "Branch or tag to read; HEAD = the default branch.", default: Some("HEAD")),
            (name: "patterns", doc: "Globs over repo-relative paths, sweep semantics.", ty: StrList, example: Some("docs/**/*.md"), default: Some("**/*")),
            (name: "kind", doc: "The item kind swept files carry.", default: Some("file")),
            (name: "max_file_bytes", doc: "Per-file size cap; larger files skip with a note.", ty: Int, default: Some("67108864")),
         ]),
        (name: "pack", summary: "A KB template at a pinned rev, imported as evidence for agent-curated adoption.",
         world: "kyyn:source@1", namespace: "pack", capabilities: (repo: true),
         component: "components/sources/pack.wasm",
         component_sha256: "1f1403f22cf4730f765f373793b176c1223d67c54177a43b946139ea9260215c",
         config: [
            (name: "template", doc: "The template directory to import (e.g. gbrain).", required: true, example: Some("gbrain")),
            (name: "rev", doc: "Full 40-hex commit OID of the templates repo — bump by proposal to take updates.", required: true, example: Some("90fd6c9f3288717e2de0572a8f33d653661b32cf")),
            (name: "repo", doc: "Templates repository (public URL, or a local path for development).", default: Some("https://github.com/drshade/kyyn-templates")),
         ]),
        (name: "salesforce", summary: "A SOQL query's records as evidence through a delegated or workload Salesforce Connection.",
         world: "kyyn:source@1", namespace: "sf",
         connection: (provider: "salesforce", capabilities: ["api"], principal_classes: [DelegatedHuman, WorkloadApplication]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "connection:instance_url", method: Get, path: "/services/data/{segment}/query"),
            (purpose: Observe, authorization: Connection, authority: "connection:instance_url", method: Get, path: "/services/data/{segment}/query/{segment}"),
         ]),
         component: "components/sources/salesforce.wasm",
         component_sha256: "74da148da153d6218c6ab5fe90d7709b632fc9b888d48952588b46ebebece1c8",
         config: [
            (name: "query", doc: "The SOQL query whose records this source ingests.", required: true, example: Some("SELECT Id, Name, StageName FROM Opportunity")),
            (name: "kind", doc: "The item kind records carry.", default: Some("sf-record")),
            (name: "api_version", doc: "REST API version.", default: Some("v62.0")),
            (name: "id_field", doc: "The field carrying each record's stable identity.", default: Some("Id")),
         ]),
        (name: "graph-mail", summary: "Microsoft 365 mail (with attachments); narrow with mail_filter.",
         world: "kyyn:source@1", namespace: "graph",
         connection: (provider: "microsoft", capabilities: ["mail-read"]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/messages"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/messages/{segment}/attachments"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/messages/{segment}/attachments/{segment}/$value"),
         ]),
         component: "components/sources/graph-mail.wasm",
         component_sha256: "270688a0b13071ef5abcdaa42d195523228b9a1a0a66c3133c1b8f68d1a7a3bf",
         config: [
            (name: "mail_filter", doc: "OData $filter fragment ANDed onto the mail window.", example: Some("contains(subject, 'Sales Update')")),
            (name: "owner_addresses", doc: "Your own addresses (lowercased) — classifies sent vs received.", ty: StrList, example: Some("you@company.com")),
         ]),
        (name: "graph-calendar", summary: "Microsoft 365 calendar events.",
         world: "kyyn:source@1", namespace: "graph",
         connection: (provider: "microsoft", capabilities: ["calendar-read"]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/calendarView"),
         ]),
         component: "components/sources/graph-calendar.wasm",
         component_sha256: "c3e100db8f5d5c0e9596b754e8a7a1b585c9acc5db60986cf86ce15558fd27a0",
         config: [
            (name: "owner_addresses", doc: "Your own addresses (lowercased).", ty: StrList, example: Some("you@company.com")),
         ]),
        (name: "graph-meetings", summary: "Microsoft 365 meetings, with artifacts where the signed-in user organizes.",
         world: "kyyn:source@1", namespace: "graph",
         connection: (provider: "microsoft", capabilities: ["meetings-read"]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/calendarView"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/onlineMeetings"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/onlineMeetings/{segment}/transcripts"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/onlineMeetings/{segment}/transcripts/{segment}/content"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/onlineMeetings/{segment}/attendanceReports"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/onlineMeetings/{segment}/attendanceReports/{segment}/attendanceRecords"),
         ]),
         component: "components/sources/graph-meetings.wasm",
         component_sha256: "3d25360ea6bfeae8eed823887efc1ea4e0ad37466b6835b7206f5f077dc9397a",
         config: [
            (name: "owner_addresses", doc: "Your own addresses (lowercased).", ty: StrList, example: Some("you@company.com")),
         ]),
        (name: "graph-chats", summary: "Teams chats and their messages (the slow crawl).",
         world: "kyyn:source@1", namespace: "graph",
         connection: (provider: "microsoft", capabilities: ["chats-read"]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/chats"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/chats/{segment}/messages"),
         ]),
         component: "components/sources/graph-chats.wasm",
         component_sha256: "b5346afeb99f8acc24fa7c66a0751ffa2400360732aa8abd64c279b530c9606c",
         config: [
            (name: "owner_addresses", doc: "Your own addresses (lowercased).", ty: StrList, example: Some("you@company.com")),
         ]),
        (name: "microsoft-files", summary: "One owner-resolved SharePoint or OneDrive file, or a recursively filtered folder, as versioned evidence.",
         world: "kyyn:source@1", namespace: "microsoft-file",
         connection: (provider: "microsoft", capabilities: ["files-read"], principal_classes: [DelegatedHuman, WorkloadApplication]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/items/{segment}"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/items/{segment}/children"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/items/{segment}/content", continuation: ProviderDownload),
         ]),
         component: "components/sources/microsoft-files.wasm",
         component_sha256: "26e90cb71f8f8189ef5d53ae8e0dc25ebdf241580fe9f93e74440a14a9e193fd",
         config: [
            (name: "resource_link", label: Some("SharePoint or OneDrive link"), doc: "Paste a browser link to one file or folder. Kyyn resolves it once and does not store the link.", required: true, example: Some("https://tenant.sharepoint.com/sites/Team/Shared%20Documents/report.xlsx"), custody: Ephemeral, control: ResourceLink),
            (name: "drive_id", label: Some("Drive identity"), doc: "Canonical drive identity produced during link resolution.", required: true, example: Some("<resolved-drive-id>")),
            (name: "item_id", label: Some("Item identity"), doc: "Canonical file or folder identity produced during link resolution.", required: true, example: Some("<resolved-item-id>")),
            (name: "item_kind", label: Some("Item type"), doc: "Resolved target type.", required: true, example: Some("file"), control: Choice(options: ["file", "folder"])),
            (name: "display_name", label: Some("Display name"), doc: "Safe owner-facing label produced during link resolution.", required: true, example: Some("report.xlsx")),
            (name: "patterns", label: Some("Folder file patterns"), doc: "For a folder, globs relative to that folder; ** crosses levels.", ty: StrList, example: Some("**/*.xlsx"), default: Some("**/*")),
            (name: "kind", label: Some("Evidence kind"), doc: "The evidence kind each included file carries.", default: Some("file")),
            (name: "max_file_bytes", label: Some("Maximum file size"), doc: "Per-file byte cap; larger files are reported and skipped.", ty: Int, default: Some("67108864")),
         ],
         configurator: (
            world: "kyyn:configurator@1",
            component: "components/configurators/microsoft-files.wasm",
            component_sha256: "0cb0964f52fde5dfda2498569e662fa060364f91dc4adcad4d50eb6019c6e97c",
            requests: [
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/shares/{segment}/driveItem"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}:/{path}"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}/drives"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root:/{path}"),
            ],
            produces: ["drive_id", "item_id", "item_kind", "display_name"],
            max_input_bytes: 65536,
            max_output_bytes: 262144,
         )),
    ],
    sinks: [
        (name: "file-replace", summary: "Atomically create or replace one owner-consented local file when its reviewed state still matches.",
         world: "kyyn:sink@1", delivery: Convergent,
         component: "components/sinks/file-replace.wasm",
         component_sha256: "2c733e506a1e6beab5e9f8463ba03a61d89dbe9eb82b4f5b510deb36b19a9641",
         config: [
            (name: "path", doc: "Absolute normalized destination path outside the KB and Kyyn state roots.", ty: Path, required: true, example: Some("/srv/kyyn/report.bin")),
         ]),
        (name: "git-ref", summary: "Compare-and-swap one owner-consented branch to one accepted preconstructed commit.",
         world: "kyyn:sink@1", delivery: CasConvergent,
         component: "components/sinks/git-ref.wasm",
         component_sha256: "d50fd78ec95ed257906decd85875dcb7083f87a517c1912cdbd8ed9ac4851fb0",
         config: [
            (name: "repository", doc: "Absolute ssh:// or https:// URL of the foreign Git repository.", required: true, example: Some("ssh://git.example/exports/team.git")),
            (name: "reference", doc: "Canonical full branch reference bound by standing consent.", required: true, example: Some("refs/heads/main")),
         ]),
        (name: "microsoft-file-replace", summary: "Create or replace one owner-resolved SharePoint/OneDrive file when its reviewed provider state still matches.",
         world: "kyyn:sink@1", delivery: Convergent,
         connection: (provider: "microsoft", capabilities: ["files-write"], principal_classes: [DelegatedHuman, WorkloadApplication]),
         component: "components/sinks/microsoft-file-replace.wasm",
         component_sha256: "272853d4e33b904692fedc329def60f258cdbf17a7e3fbe6de828640d24b9b74",
         capabilities: (requests: [
            (name: "existing-metadata", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}",
             path_bindings: ["config:drive_id", "config:item_id"], body: None,
             max_response_bytes: 1048576, timeout_ms: 30000, max_operations: 2),
            (name: "existing-content", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}/content",
             path_bindings: ["config:drive_id", "config:item_id"], body: None,
             continuation: ProviderDownload,
             max_response_bytes: 16777216, timeout_ms: 120000, max_operations: 2),
            (name: "existing-upload", phase: Apply, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Put,
             path: "/v1.0/drives/{segment}/items/{segment}/content",
             path_bindings: ["config:drive_id", "config:item_id"], body: AcceptedArtifact,
             headers: ["content-type", "if-match"],
             max_response_bytes: 1048576, timeout_ms: 120000, max_operations: 1),
            (name: "child-metadata", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}:/{segment}",
             path_bindings: ["config:drive_id", "config:item_id", "config:filename"], body: None,
             max_response_bytes: 1048576, timeout_ms: 30000, max_operations: 2),
            (name: "child-content", phase: Observe, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Get,
             path: "/v1.0/drives/{segment}/items/{segment}:/{segment}:/content",
             path_bindings: ["config:drive_id", "config:item_id", "config:filename"], body: None,
             continuation: ProviderDownload,
             max_response_bytes: 16777216, timeout_ms: 120000, max_operations: 2),
            (name: "child-upload", phase: Apply, authorization: Connection,
             authority: "https://graph.microsoft.com", method: Put,
             path: "/v1.0/drives/{segment}/items/{segment}:/{segment}:/content",
             path_bindings: ["config:drive_id", "config:item_id", "config:filename"], body: AcceptedArtifact,
             headers: ["content-type", "if-none-match"],
             max_response_bytes: 1048576, timeout_ms: 120000, max_operations: 1),
         ]),
         config: [
            (name: "resource_link", label: Some("SharePoint or OneDrive link"), doc: "Paste a browser link to one file or folder. Kyyn resolves it once and does not store the link.", required: true, example: Some("https://tenant.sharepoint.com/sites/Team/Shared%20Documents/report.xlsx"), custody: Ephemeral, control: ResourceLink),
            (name: "drive_id", label: Some("Drive identity"), doc: "Canonical drive identity produced during link resolution.", required: true, example: Some("<resolved-drive-id>")),
            (name: "item_id", label: Some("Item identity"), doc: "Canonical file or folder identity produced during link resolution.", required: true, example: Some("<resolved-item-id>")),
            (name: "item_kind", label: Some("Item type"), doc: "Resolved target type.", required: true, example: Some("file"), control: Choice(options: ["file", "folder"])),
            (name: "display_name", label: Some("Display name"), doc: "Safe owner-facing label produced during link resolution.", required: true, example: Some("report.xlsx")),
            (name: "target_mode", label: Some("Output action"), doc: "Replace the linked file, or create/replace one named child in the linked folder.", required: true, example: Some("existing-file"), control: Choice(options: ["existing-file", "folder-child"])),
            (name: "filename", label: Some("Filename in folder"), doc: "Required only for a folder output.", example: Some("dashboard.html")),
         ],
         configurator: (
            world: "kyyn:configurator@1",
            component: "components/configurators/microsoft-files.wasm",
            component_sha256: "0cb0964f52fde5dfda2498569e662fa060364f91dc4adcad4d50eb6019c6e97c",
            requests: [
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/shares/{segment}/driveItem"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}:/{path}"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/sites/{segment}/drives"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root"),
                (purpose: Configure, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/drives/{segment}/root:/{path}"),
            ],
            produces: ["drive_id", "item_id", "item_kind", "display_name"],
            max_input_bytes: 65536,
            max_output_bytes: 262144,
         )),
    ],
)
