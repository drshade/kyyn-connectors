         )),
        (name: "graph-chats", summary: "Teams chats and their messages (the slow crawl).",
         world: "kyyn:source@1", namespace: "graph",
         connection: (provider: "microsoft", capabilities: ["chats-read"]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/chats"),
