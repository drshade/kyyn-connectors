             parameters: Struct(fields: [
                (name: "items", description: "Exact item-version keys for the held occurrence.", type: List(item: String(max_bytes: 512), max_items: 128)),
                (name: "occurrence_id", description: "Connector occurrence identity shared by every item.", type: String(max_bytes: 512)),
             ]), result: Text(max_bytes: 2097152), world: "kyyn:evidence-tool@1", execution_profile: "kyyn-evidence-tool-contained-1",
             component: "components/evidence-tools/graph-meeting-detail.wasm", component_sha256: "b2469eeed534c444d999e402578e69dcd9261222a078259f780d5221fce32584"),
            (name: "meeting-transcript", description: "Page one retained meeting transcript on complete WebVTT cue boundaries where possible.",
             parameters: Struct(fields: [
