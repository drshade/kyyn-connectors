// First-party, digest-pinned, direction-distinct connectors. Every authority
// grant belongs to one component; repository co-location grants no union.
// Provider-selected file downloads are explicit, bounded host continuations;
// their bearer-like URLs never cross into connector memory.
(
    connector_manifest: 1,
    connections: [
        (name: "microsoft", summary: "A reusable Microsoft 365 account connection with least-privilege capability enrollment.",
         world: "kyyn:connection@1",
         component: "components/connections/microsoft-connection.wasm",
         component_sha256: "428c4013eca57555d7470076c11c9b24c6985e42a9333de52622d3d0456adae7",
         capabilities: ["calendar-read", "chats-read", "directory-users-read", "files-read", "files-write", "mail-read", "meetings-read"],
         principal_classes: [DelegatedHuman, WorkloadApplication],
         workload_recipes: [(
            name: "client-secret",
            summary: "Exchange one reviewed Entra application client secret for a short-lived Microsoft Graph application token.",
            inputs: [(
                name: "client-secret",
                label: "Client secret",
                doc: "Secret for the accepted tenant-specific Entra application; supply it through local enrollment or a runner override.",
                kind: ClientSecret,
                max_bytes: 16384,
            )],
         )],
         requests: [
            (purpose: Authenticate, authorization: None, authority: "https://login.microsoftonline.com", method: Post, path: "/{segment}/oauth2/v2.0/devicecode"),
            (purpose: Authenticate, authorization: None, authority: "https://login.microsoftonline.com", method: Post, path: "/{segment}/oauth2/v2.0/token"),
         ],
         verification_origins: [
            "https://microsoft.com",
            "https://www.microsoft.com",
            "https://login.microsoft.com",
            "https://login.microsoftonline.com",
         ],
         config: [
            (name: "tenant", doc: "Entra tenant GUID or domain. Delegated sign-in may use organizations; workload Connections require an explicit tenant.", default: Some("organizations")),
            (name: "client_id", doc: "Entra application id. Delegated sign-in defaults to Kyyn's shared public app; workload Connections require the owner's explicit application id.", default: Some("53ddb21b-849f-45a3-8168-8a0e555f386f")),
         ]),
        (name: "salesforce", summary: "A reusable Salesforce org connection using delegated device flow or a workload application.",
         world: "kyyn:connection@1",
         component: "components/connections/salesforce-connection.wasm",
         component_sha256: "4e0be444ca759fe0fc484f0f27e024678ae8606dab5fa0fd2c700cffa57a0e68",
         capabilities: ["api"],
         principal_classes: [DelegatedHuman, WorkloadApplication],
         workload_recipes: [(
            name: "client-secret",
            summary: "Exchange one reviewed Salesforce application client secret for a short-lived integration-user token.",
            inputs: [(
                name: "client-secret",
                label: "Client secret",
                doc: "Consumer secret for the accepted Salesforce application; supply it through local enrollment or a runner override.",
                kind: ClientSecret,
                max_bytes: 16384,
            )],
         )],
         requests: [
            (purpose: Authenticate, authorization: None, authority: "config:instance_url", method: Post, path: "/services/oauth2/token"),
         ],
         verification_origins: [
            "config:instance_url",
            "https://login.salesforce.com",
            "https://test.salesforce.com",
         ],
         config: [
            (name: "instance_url", doc: "The org's exact My Domain HTTPS origin.", ty: HttpsOrigin, required: true, example: Some("https://acme.my.salesforce.com")),
            (name: "client_id", doc: "The Connected or External Client App consumer key (not a secret). Enable device flow for delegated use or client credentials with an integration Run As user for workload use.", required: true, example: Some("3MVG9…")),
         ]),
    ],
    sources: [
        (name: "sweep", summary: "Glob a local directory tree into hashed, versioned evidence.",
         world: "kyyn:source@1", namespace: "file",
         component: "components/sources/sweep.wasm",
         component_sha256: "251e6154f95130312f2405a19ed2dc6105b828ebb9584914d9907408434ebe4e",
         config: [
            (name: "root", doc: "The directory tree to sweep (~ expands).", ty: Path, required: true, example: Some("~/notes")),
            (name: "patterns", doc: "Globs relative to root; * stays within one level, ** crosses.", ty: StrList, example: Some("**/*.md"), default: Some("**/*")),
            (name: "kind", doc: "The item kind swept files carry.", default: Some("file")),
            (name: "max_file_bytes", doc: "Per-file size cap; larger files skip with a note.", ty: Int, default: Some("67108864")),
         ]),
        (name: "git-repo", summary: "Any git repository's tree (local or remote) at a ref, swept as versioned evidence.",
         world: "kyyn:source@1", namespace: "repo", capabilities: (repo: true),
         component: "components/sources/git-repo.wasm",
         component_sha256: "b747da4db6293d804d92dd700eeacdb01bb8b0b93acb6c1d43454389d00a9fc9",
         config: [
            (name: "url", doc: "Git URL or local path of the repository.", required: true, example: Some("https://github.com/org/repo")),
            (name: "git_ref", doc: "Branch or tag to read; HEAD = the default branch.", default: Some("HEAD")),
            (name: "patterns", doc: "Globs over repo-relative paths, sweep semantics.", ty: StrList, example: Some("docs/**/*.md"), default: Some("**/*")),
            (name: "kind", doc: "The item kind swept files carry.", default: Some("file")),
            (name: "max_file_bytes", doc: "Per-file size cap; larger files skip with a note.", ty: Int, default: Some("67108864")),
         ]),
        (name: "pack", summary: "A KB template at a pinned rev, imported as evidence for agent-curated adoption.",
         world: "kyyn:source@1", namespace: "pack", capabilities: (repo: true),
         component: "components/sources/pack.wasm",
         component_sha256: "32c0a001317a9dd3a48c44772e16fb3b1bb1e98f4e612277e844d034b2cfde38",
         config: [
            (name: "template", doc: "The template directory to import (e.g. gbrain).", required: true, example: Some("gbrain")),
            (name: "rev", doc: "Full 40-hex commit OID of the templates repo — bump by proposal to take updates.", required: true, example: Some("90fd6c9f3288717e2de0572a8f33d653661b32cf")),
            (name: "repo", doc: "Templates repository (public URL, or a local path for development).", default: Some("https://github.com/drshade/kyyn-templates")),
         ]),
        (name: "salesforce", summary: "A SOQL query's records as evidence through a delegated or workload Salesforce Connection.",
         world: "kyyn:source@1", namespace: "sf",
         connection: (provider: "salesforce", capabilities: ["api"], principal_classes: [DelegatedHuman, WorkloadApplication]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "connection:instance_url", method: Get, path: "/services/data/{segment}/query"),
            (purpose: Observe, authorization: Connection, authority: "connection:instance_url", method: Get, path: "/services/data/{segment}/query/{segment}"),
         ]),
         component: "components/sources/salesforce.wasm",
         component_sha256: "ebd39a7f60cb68c4bdf32d783ab3d96447a2dc365c4f537c757f8f2de5da2ba8",
         config: [
            (name: "query", doc: "The SOQL query whose records this source ingests.", required: true, example: Some("SELECT Id, Name, StageName FROM Opportunity")),
            (name: "kind", doc: "The item kind records carry.", default: Some("sf-record")),
            (name: "api_version", doc: "REST API version.", default: Some("v62.0")),
            (name: "id_field", doc: "The field carrying each record's stable identity.", default: Some("Id")),
         ]),
        (name: "graph-mail", summary: "Microsoft 365 mail (with attachments); narrow with mail_filter.",
         world: "kyyn:source@1", namespace: "graph",
         connection: (provider: "microsoft", capabilities: ["mail-read"]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/messages"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/messages/{segment}/attachments"),
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/messages/{segment}/attachments/{segment}/$value"),
         ]),
         component: "components/sources/graph-mail.wasm",
         component_sha256: "75f04194a1f5bc5aee04941dcbc198a4f4b79c9ab903403f98ff017019a57029",
         evidence_tools: [(
            name: "message-as-text",
            description: "Render one verified Graph mail item as bounded readable text with message metadata and an explicit continuation cursor.",
            parameters: Struct(fields: [
                (name: "item", description: "Exact source item-version key.", type: String(max_bytes: 512)),
                (name: "cursor", description: "Optional byte cursor in normalized text.", type: Optional(U64), required: false),
                (name: "max_bytes", description: "Requested output text bytes, bounded to 131072.", type: Optional(U64), required: false),
            ]),
            result: Text(max_bytes: 262144),
            world: "kyyn:evidence-tool@1",
            execution_profile: "kyyn-evidence-tool-contained-1",
            component: "components/evidence-tools/graph-message-as-text.wasm",
            component_sha256: "2762530a2165782cff9f62b8d2491e02525eb1afd1a188b5dca34b06511c23fc",
         )],
         config: [
            (name: "mail_filter", doc: "OData $filter fragment ANDed onto the mail window.", example: Some("contains(subject, 'Sales Update')")),
            (name: "owner_addresses", doc: "Your own addresses (lowercased) — classifies sent vs received.", ty: StrList, example: Some("you@company.com")),
         ]),
        (name: "graph-calendar", summary: "Microsoft 365 calendar events.",
         world: "kyyn:source@1", namespace: "graph",
         connection: (provider: "microsoft", capabilities: ["calendar-read"]),
         capabilities: (requests: [
            (purpose: Observe, authorization: Connection, authority: "https://graph.microsoft.com", method: Get, path: "/v1.0/me/calendarView"),
